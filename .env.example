# .env.example - Example environment variables for the project.
# Copy to .env and fill in real values. NEVER commit real secrets.

# Path to your local raw documents directory
RAW_DIR='/path/to/your/docs'

# Path to your local LibreOffice soffice binary (optional: not needed in Docker container)
SOFFICE_PATH='/path/to/soffice'

# OpenAI API key
OPENAI_API_KEY='your_openai_api_key_here'

# After creating .env from this template, add real .env to .gitignore (already present) and keep secrets secret.
